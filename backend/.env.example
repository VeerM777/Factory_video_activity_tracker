# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored -- never commit real keys.

# --- Option A: Google AI Studio (free tier, no GCP project needed) ---
GEMINI_USE_VERTEX=false

GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Option B: Vertex AI (production path -- VPC-SC/CMEK/data residency) ---
# GEMINI_USE_VERTEX=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# gemini-2.5-pro / gemini-3.1-pro-preview etc. return 429 RESOURCE_EXHAUSTED
# (quota 0) on the AI Studio free tier as of 2026-07 -- verified against a
# live key. gemini-flash-latest and gemini-3-flash-preview both work free.
# Swap to a pro-tier model once billing is enabled (Option B, or AI Studio
# pay-as-you-go) if classification quality on the flash tier isn't enough.
GEMINI_MODEL=gemini-flash-latest
